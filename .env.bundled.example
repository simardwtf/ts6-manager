# ─────────────────────────────────────────────────────────────────────────────
# .env for docker-compose.bundled.yml  (copy this file to .env and fill it in)
# ─────────────────────────────────────────────────────────────────────────────

# ── TS6 Manager secrets ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars

# Optional separate encryption key for stored credentials.
# Defaults to JWT_SECRET when left blank.
ENCRYPTION_KEY=

# ── TeamSpeak 6 server ────────────────────────────────────────────────────────
# The WebQuery API key for the bundled TS6 server.
# This value is written into the TS6 server config AND used by the manager
# to connect automatically — they MUST match.
# Generate with: openssl rand -hex 24
TS_APIKEY=change-this-to-a-random-api-key

# Display name shown in the manager UI for this server connection.
TS_AUTOCONFIG_NAME=My TeamSpeak Server

# Accept the TS6 server license (required by the official image).
TS6_LICENSE_ACCEPTED=accept

# ── Ports (optional overrides) ────────────────────────────────────────────────
# MANAGER_PORT=3000      # Web UI port  (default 3000)
# TS_VOICE_PORT=9987     # TS voice UDP  (default 9987)
# TS_WEBQUERY_PORT=10080 # WebQuery HTTP (default 10080)
# TS_SSH_PORT=10022      # ServerQuery SSH (default 10022)

# ── TS6 Docker image ──────────────────────────────────────────────────────────
# Override if you use a custom or private TS6 server image.
# TS6_IMAGE=teamspeak/teamspeak6-server:latest
