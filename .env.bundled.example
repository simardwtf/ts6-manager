# Optional .env for docker-compose.bundled.yml
# Everything has a working default — only change what you need.

# ── Security (change these in production) ────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=bundled-default-change-me-in-production

# The TS6 serveradmin password (used once on first boot to generate the API key)
TS_ADMIN_PASSWORD=serveradmin

# ── Customisation ─────────────────────────────────────────────────────────────
# Display name shown in the manager for the TS6 server connection
TS_SERVER_NAME=My TeamSpeak Server

# Web UI port
# MANAGER_PORT=3000

# TeamSpeak ports (only needed if you want non-default ports)
# TS_VOICE_PORT=9987
# TS_FT_PORT=30033
# TS_WEBQUERY_PORT=10080
# TS_SSH_PORT=10022
